{
    "version":  "0.2.0",
    "description":  "Visual payload router for QR capture and automation",
    "homepage":  "https://github.com/zunaidFarouque/VisioFlow-QR",
    "license":  "MIT",
    "architecture":  {
                         "64bit":  {
                                       "url":  "https://github.com/zunaidFarouque/VisioFlow-QR/releases/download/v0.2.0/visioflow-win-x64.zip",
                                       "hash":  "49c8ece521bec820ac247550a555d28217b5b3843614be868b6923af5ef2fb97",
                                       "extract_dir":  "visioflow-win-x64"
                                   }
                     },
    "bin":  "visioflow.exe",
    "env_set":  {
                    "VISIOFLOW_MODELS_DIR":  "$dir\\models"
                },
    "shortcuts":  [
                      [
                          "launchers\\camera-auto.vbs",
                          "VisioFlow\\VisioFlow QR Camera (auto)",
                          "",
                          "logo v2.ico"
                      ],
                      [
                          "launchers\\camera-copy.vbs",
                          "VisioFlow\\VisioFlow QR Camera (copy)",
                          "",
                          "logo v2.ico"
                      ],
                      [
                          "launchers\\snip-auto.vbs",
                          "VisioFlow\\VisioFlow QR Snip (auto)",
                          "",
                          "logo v2.ico"
                      ],
                      [
                          "launchers\\snip-copy.vbs",
                          "VisioFlow\\VisioFlow QR Snip (copy)",
                          "",
                          "logo v2.ico"
                      ],
                      [
                          "launchers\\clipboard-qr.vbs",
                          "VisioFlow\\VisioFlow Clipboard to QR",
                          "",
                          "logo v2.ico"
                      ]
                  ],
    "persist":  "data",
    "post_install":  [
                         "$ErrorActionPreference = \u0027Stop\u0027",
                         "$persistRules = Join-Path $persist_dir \u0027rules.json\u0027",
                         "$appRulesDir = Join-Path $env:APPDATA \u0027visioflow\u0027",
                         "$appRules = Join-Path $appRulesDir \u0027rules.json\u0027",
                         "$defaultRules = Join-Path $dir \u0027default-rules.json\u0027",
                         "New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
                         "if (Test-Path $persistRules) { New-Item -ItemType Directory -Path $appRulesDir -Force | Out-Null; Copy-Item $persistRules $appRules -Force } elseif (Test-Path $appRules) { Copy-Item $appRules $persistRules -Force } elseif (Test-Path $defaultRules) { Copy-Item $defaultRules $persistRules -Force; New-Item -ItemType Directory -Path $appRulesDir -Force | Out-Null; Copy-Item $defaultRules $appRules -Force }",
                         "$desktop = [Environment]::GetFolderPath(\u0027Desktop\u0027)",
                         "$programs = [Environment]::GetFolderPath(\u0027Programs\u0027)",
                         "$startMenu = Join-Path $programs \u0027VisioFlow\u0027",
                         "$legacy = @(\u0027VisioFlow Scan (Auto)\u0027, \u0027VisioFlow Scan (Copy)\u0027, \u0027VisioFlow Scan (Plain)\u0027)",
                         "foreach ($n in $legacy) { Remove-Item (Join-Path $desktop \"$n.lnk\") -Force -ErrorAction SilentlyContinue; Remove-Item (Join-Path $startMenu \"$n.lnk\") -Force -ErrorAction SilentlyContinue }",
                         "$launcherRoot = Join-Path $env:APPDATA \u0027VisioFlow\\launchers\u0027",
                         "foreach ($f in @(\u0027scan-auto.cmd\u0027, \u0027scan-copy.cmd\u0027, \u0027scan-plain.cmd\u0027, \u0027scan-auto.vbs\u0027, \u0027scan-copy.vbs\u0027, \u0027scan-plain.vbs\u0027, \u0027camera-auto.cmd\u0027, \u0027camera-copy.cmd\u0027, \u0027snip-auto.cmd\u0027, \u0027snip-copy.cmd\u0027)) { Remove-Item (Join-Path $launcherRoot $f) -Force -ErrorAction SilentlyContinue }",
                         "Write-Host \u0027VisioFlow bootstrap complete (rules + Start Menu shortcuts via Scoop).\u0027"
                     ],
    "pre_uninstall":  [
                          "$ErrorActionPreference = \u0027Stop\u0027",
                          "$appRules = Join-Path $env:APPDATA \u0027visioflow\\rules.json\u0027",
                          "$persistRules = Join-Path $persist_dir \u0027rules.json\u0027",
                          "if (Test-Path $appRules) { New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null; Copy-Item $appRules $persistRules -Force }"
                      ],
    "uninstaller":  {
                        "script":  [
                                       "$ErrorActionPreference = \u0027Stop\u0027",
                                       "$desktop = [Environment]::GetFolderPath(\u0027Desktop\u0027)",
                                       "$programs = [Environment]::GetFolderPath(\u0027Programs\u0027)",
                                       "$startMenu = Join-Path $programs \u0027VisioFlow\u0027",
                                       "$names = @(\u0027VisioFlow QR Camera (auto)\u0027, \u0027VisioFlow QR Camera (copy)\u0027, \u0027VisioFlow QR Snip (auto)\u0027, \u0027VisioFlow QR Snip (copy)\u0027, \u0027VisioFlow Clipboard to QR\u0027, \u0027VisioFlow Scan (Auto)\u0027, \u0027VisioFlow Scan (Copy)\u0027, \u0027VisioFlow Scan (Plain)\u0027)",
                                       "foreach ($n in $names) { Remove-Item (Join-Path $desktop \"$n.lnk\") -Force -ErrorAction SilentlyContinue; Remove-Item (Join-Path $startMenu \"$n.lnk\") -Force -ErrorAction SilentlyContinue }",
                                       "$launcherRoot = Join-Path $env:APPDATA \u0027VisioFlow\\launchers\u0027",
                                       "if (Test-Path $launcherRoot) { Remove-Item $launcherRoot -Recurse -Force -ErrorAction SilentlyContinue }",
                                       "if (Test-Path $startMenu) { if (-not (Get-ChildItem $startMenu -ErrorAction SilentlyContinue)) { Remove-Item $startMenu -Force -ErrorAction SilentlyContinue } }",
                                       "Write-Host \u0027Removed VisioFlow legacy shortcuts and launchers. Rules kept in scoop persist (scoop uninstall -p to purge). visioflow: protocol registry left in HKCU (refreshed on next notify test).\u0027"
                                   ]
                    },
    "checkver":  {
                     "github":  "https://github.com/zunaidFarouque/VisioFlow-QR"
                 },
    "autoupdate":  {
                       "architecture":  {
                                            "64bit":  {
                                                          "url":  "https://github.com/zunaidFarouque/VisioFlow-QR/releases/download/v$version/visioflow-win-x64.zip",
                                                          "extract_dir":  "visioflow-win-x64"
                                                      }
                                        }
                   }
}
